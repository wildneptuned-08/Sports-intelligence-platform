# ─── Sports Intelligence Platform — Environment Variables ───────────────────
# Copy to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
# Valid values: development, staging, production
ENVIRONMENT=development

# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED. No default — must be set explicitly.
# Local Docker:  postgresql+asyncpg://sip:sip_password@postgres:5432/sip_db
# Supabase:      postgresql+asyncpg://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── External APIs ────────────────────────────────────────────────────────────
# API-Football via api-sports.io
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Football-Data.org (future)
FOOTBALL_DATA_KEY=

# The Odds API (future)
THE_ODDS_API_KEY=

# ── ETL Scheduler ────────────────────────────────────────────────────────────
ETL_SYNC_FIXTURES_INTERVAL_HOURS=6
ETL_SYNC_RESULTS_INTERVAL_HOURS=1
ETL_ENABLED_LEAGUES=la-liga,premier-league

# ── Observability ────────────────────────────────────────────────────────────
# Set Sentry DSN in staging/production.
SENTRY_DSN=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated origins. Add your Vercel domain in production.
# Example: https://your-app.vercel.app,https://custom-domain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Server ───────────────────────────────────────────────────────────────────
# Render sets PORT automatically. Only override for local use.
PORT=8000
