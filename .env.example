# ─── Sports Intelligence Platform — Environment Variables ───────────────────
# Copy to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_64_char_hex_string
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# Docker Compose default (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://sip:sip_password@postgres:5432/sip_db

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── External APIs (Sprint 2+) ────────────────────────────────────────────────
# API-Football via RapidAPI — https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=

# Football-Data.org — https://www.football-data.org/
FOOTBALL_DATA_KEY=

# The Odds API — https://the-odds-api.com/
THE_ODDS_API_KEY=

# ── ETL Scheduler (Sprint 2+) ────────────────────────────────────────────────
ETL_SYNC_FIXTURES_INTERVAL_HOURS=6
ETL_SYNC_RESULTS_INTERVAL_HOURS=1
ETL_ENABLED_LEAGUES=la-liga,premier-league

# ── Observability ────────────────────────────────────────────────────────────
# Leave empty in development. Set Sentry DSN in production (Sprint 6).
SENTRY_DSN=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development: allow localhost. Production (Phase 2): add your Netlify domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
